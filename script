      "<tr style='background: #f8f9fa; border-bottom: 2px solid #ddd;'>" +
      "<th style='text-align: left; padding: 8px;'>Account</th>" +
      "<th style='text-align: right; padding: 8px;'>Cost</th>" +
      "<th style='text-align: right; padding: 8px;'>Revenue</th>" +
      "<th style='text-align: right; padding: 8px;'>ROAS</th>" +
      "<th style='text-align: right; padding: 8px;'>Conversions</th>" +
      "</tr>";
    
    for (var i = 0; i < accountData.length; i++) {
      var acc = accountData[i];
      htmlBody += 
        "<tr style='border-bottom: 1px solid #eee;'>" +
        "<td style='padding: 8px;'>" + acc.name + "</td>" +
        "<td style='text-align: right; padding: 8px;'>" + formatCurrency(acc.metrics.cost) + "</td>" +
        "<td style='text-align: right; padding: 8px;'>" + formatCurrency(acc.metrics.revenue) + "</td>" +
        "<td style='text-align: right; padding: 8px;'>" + acc.metrics.roas.toFixed(2) + "x</td>" +
        "<td style='text-align: right; padding: 8px;'>" + acc.metrics.conversions.toFixed(0) + "</td>" +
        "</tr>";
    }
    htmlBody += "</table>";
  }
  
  htmlBody += 
    "<p style='margin-top: 30px; font-size: 12px; color: #666;'>Generated by Google Ads Script on " + 
    Utilities.formatDate(new Date(), AdsApp.currentAccount().getTimeZone(), 'dd MMM yyyy HH:mm') + "</p>";
  htmlBody += "</body></html>";
  
  // Send email
  var mailOptions = {
    htmlBody: htmlBody
  };
  
  if (config.email.ccRecipients) {
    mailOptions.cc = config.email.ccRecipients;
  }
  
  MailApp.sendEmail(
    config.email.recipient,
    config.email.subject + " - " + dateRange.label,
    "Please view this email in HTML format.",
    mailOptions
  );
}

/**
 * Get status badge HTML
 */
function getStatusBadge(status) {
  var colors = {
    "ON PACE": "#137333",
    "ON TRACK": "#137333",
    "OVER PACE": "#d93025",
    "UNDER PACE": "#f9ab00",
    "SLIGHTLY UNDER": "#f9ab00",
    "UNDER TARGET": "#d93025"
  };
  
  var color = colors[status] || "#5f6368";
  
  return "<span style='background: " + color + "; color: white; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: bold;'>" + 
         status + "</span>";
}

/**
 * Get campaign label badge HTML
 */
function getCampaignLabelBadge(label) {
  var config = {
    "SCALE UP": { color: "#137333", icon: "🚀" },
    "ON TRACK": { color: "#1a73e8", icon: "✅" },
    "NEEDS ATTENTION": { color: "#f9ab00", icon: "⚠️" },
    "UNDERPERFORMING": { color: "#d93025", icon: "🔴" },
    "PAUSED": { color: "#5f6368", icon: "⏸️" },
    "REMOVED": { color: "#9aa0a6", icon: "🗑️" }
  };
  
  var labelConfig = config[label] || { color: "#5f6368", icon: "" };
  
  return "<span style='background: " + labelConfig.color + "; color: white; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: bold;'>" + 
         labelConfig.icon + " " + label + "</span>";
}
